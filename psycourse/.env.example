# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.
# Nilai di bawah hanya untuk pengembangan lokal (cocok dengan docker-compose.yml).

DATABASE_URL="postgresql://psycourse:psycourse_dev@localhost:5432/psycourse"

# Rahasia untuk menandatangani hash OTP. Minimal 32 karakter, harus acak, dan
# berbeda di tiap lingkungan (lokal, staging, produksi). Buat dengan:
#   openssl rand -base64 32
AUTH_SECRET=

# Pengiriman email OTP lewat SMTP. Kosongkan SMTP_HOST kalau tidak mau mengirim email:
# di lokal kode OTP dicetak ke terminal `npm run dev`; di produksi pengiriman akan gagal.
#
# Lokal dengan Mailpit (docker compose up -d mailpit, lihat email di http://localhost:8025):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   MAIL_FROM="PsyCourse <no-reply@localhost>"
#
# Gmail (staging/uji coba): butuh Verifikasi 2 Langkah dan Sandi Aplikasi, BUKAN kata sandi akun.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=alamat-akun@gmail.com
#   SMTP_PASS=sandi-aplikasi-16-karakter
#   MAIL_FROM="PsyCourse <alamat-akun@gmail.com>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Kata sandi akun demo yang dibuat oleh `npx prisma db seed` (siswa.demo@example.com dan
# admin.demo@example.com). Kalau kosong, lokal memakai kata sandi bawaan di seed.ts.
# Di staging yang bisa diakses dari internet, WAJIB diisi dengan kata sandi yang kuat.
SEED_DEMO_PASSWORD=
