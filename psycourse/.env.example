# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.
# Nilai di bawah hanya untuk pengembangan lokal (cocok dengan docker-compose.yml).

DATABASE_URL="postgresql://psycourse:psycourse_dev@localhost:5432/psycourse"

# Rahasia untuk menandatangani hash OTP. Minimal 32 karakter, harus acak, dan
# berbeda di tiap lingkungan (lokal, staging, produksi). Buat dengan:
#   openssl rand -base64 32
AUTH_SECRET=
